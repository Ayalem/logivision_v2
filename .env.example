# LOGIVISION — example environment variables.
# Copy to `.env` and fill in. NEVER commit `.env`.
# Only the variables needed for Sprint 1.1 are listed here.
# More will be added as services are introduced.

# ---------- PostgreSQL ----------
POSTGRES_USER=logivision
POSTGRES_PASSWORD=change-me-in-local
POSTGRES_DB=logivision
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------- MinIO (S3-compatible object store) ----------
MINIO_ROOT_USER=logivision
MINIO_ROOT_PASSWORD=change-me-in-local-minimum-8-chars
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_PORT=9001

# Aliases consumed by boto3 / dvc / mlflow (point to the same MinIO).
AWS_ACCESS_KEY_ID=${MINIO_ROOT_USER}
AWS_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
AWS_DEFAULT_REGION=us-east-1
MLFLOW_S3_ENDPOINT_URL=${MINIO_ENDPOINT}

# ---------- MLflow ----------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_BACKEND_STORE_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/mlflow
MLFLOW_ARTIFACT_ROOT=s3://mlflow/

# ---------- Buckets created at bootstrap ----------
BUCKET_MLFLOW=mlflow
BUCKET_DATASETS=datasets
BUCKET_MODELS=models
BUCKET_FRAMES=frames
