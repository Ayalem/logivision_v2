{
  "type": "record",
  "name": "Detection",
  "namespace": "com.logivision.events.v1",
  "doc": "Output of inference on a single frame.",
  "fields": [
    {"name": "frame_id", "type": "string", "doc": "UUID generated by frame-grabber"},
    {"name": "camera_id", "type": "string"},
    {"name": "timestamp_ms", "type": "long", "doc": "epoch ms when the frame was captured"},
    {"name": "model_version", "type": "string", "doc": "e.g. 'logivision-detector/v3/Production' or 'fallback:yolov8n.pt'"},
    {"name": "inference_ms", "type": "float"},
    {"name": "frame_uri", "type": "string", "doc": "s3://frames/<camera-id>/<date>/<frame-id>.jpg"},
    {
      "name": "detections",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "BoundingBox",
          "fields": [
            {"name": "class_id", "type": "int"},
            {"name": "class_name", "type": "string"},
            {"name": "confidence", "type": "float"},
            {"name": "x1", "type": "float"},
            {"name": "y1", "type": "float"},
            {"name": "x2", "type": "float"},
            {"name": "y2", "type": "float"}
          ]
        }
      }
    }
  ]
}
